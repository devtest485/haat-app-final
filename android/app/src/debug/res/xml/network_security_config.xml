<?xml version="1.0" encoding="utf-8"?>
<!--
  Lets a debug build talk to a backend running on the developer's own machine.

  Android has blocked cleartext HTTP since API 28, so without this a phone on the same
  Wi-Fi fails every request with "CLEARTEXT communication to 192.168.x.x not permitted
  by network security policy" — which reads like a bug in the app.

  This file is under src/debug, so it applies to debug builds only. A release build
  keeps the platform default and refuses plaintext everywhere. The alternative often
  reached for — android:usesCleartextTraffic="true" in the main manifest — would ship
  that permission to production and allow plaintext to any host on the internet.

  The exemptions are named individually rather than opened by range: these are the four
  addresses a developer machine is actually reached by, and anything else should still
  be refused even in debug.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- This machine, over the LAN. Update alongside apiBaseUrl in
             assets/environment_values/environment.json. -->
        <domain includeSubdomains="false">192.168.18.4</domain>

        <!-- The host, as seen from an Android emulator. -->
        <domain includeSubdomains="false">10.0.2.2</domain>

        <!-- The handset itself, which is what `adb reverse` forwards to. -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
