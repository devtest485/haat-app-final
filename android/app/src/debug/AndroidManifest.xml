<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.mycompany.haat">
    <!-- Flutter needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!--
      Permits plaintext HTTP to the developer's machine, and nowhere else.

      Debug builds only: this manifest is merged into debug variants, so a release
      build keeps Android's default and refuses cleartext everywhere. tools:replace is
      needed because the main manifest's <application> element wins the merge
      otherwise.
    -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:networkSecurityConfig" />
</manifest>
