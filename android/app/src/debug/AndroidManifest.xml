<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mycompany.haat">
    <!-- Flutter needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!--
      Debug builds only. Points at res/xml/network_security_config.xml, which permits
      cleartext so the handset can reach a backend running on the developer's machine.
      Merged into the debug manifest alone, so a release build is unaffected and still
      refuses plain HTTP.
    -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:networkSecurityConfig"
        xmlns:tools="http://schemas.android.com/tools" />
</manifest>
